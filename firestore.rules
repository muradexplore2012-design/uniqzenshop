rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid in ['MB2gmA9yrEc6d33WZOF9dr1czWz1', 'pXg4B6DxU6OCe1PkEGe8DJWnMH72'] ||
        (request.auth.token.email != null && (
          request.auth.token.email in ['uniqzenshop@gmail.com', 'admin@uniqzen.com'] ||
          request.auth.token.email.matches('.*admin.*')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products: Public read for active gadgets, admin full access, stock deduction during checkout
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'variants', 'updatedAt'])
      );
    }

    // Categories: Public read for active categories, admin full access
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners: Public read for hero banners & side posters, admin full access
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Settings: Public read for store identity, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Static Pages / Policies: Public read, admin write
    match /pages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: Public read for validation, admin write, checkout usage counter
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'updatedAt'])
      );
    }

    // Reviews: Public read only for approved reviews; guest and customer can submit pending
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Orders: Anyone can track or create an order; admin has full manage access
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Users: Private to individual user, admin full access
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'customer' ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isAdmin();
    }

    // Admin Audit Logs: Strictly admin access
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}

